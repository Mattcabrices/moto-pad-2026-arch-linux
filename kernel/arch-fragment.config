# Applied on top of kernel/stock.config by scripts/22-kernel-config.sh.
#
# Deliberately left off because they are likely to change struct layouts used by
# stock vendor modules: SYSVIPC (task_struct), USER_NS, PID_NS. Add one only if
# the CRC comparison against the stock kernel stays clean and something needs it.

# udev device nodes
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# systemd and udev
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# Xorg opens a virtual terminal at startup
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- Build-only changes ---
# Stock points at a whitelist file on Google's build machine. Exporting all symbols
# is a superset, so vendor modules still resolve.
# CONFIG_TRIM_UNUSED_KSYMS is not set
# A rebuilt kernel has a new signing key, so stock GKI modules count as unsigned.
# CONFIG_MODULE_SIG_PROTECT is not set
# ThinLTO needs far less memory than full LTO on this 16 GB machine. CFI stays on.
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
# DEBUG_INFO and BTF must stay on. Turning off DEBUG_INFO was the one change that
# altered CRCs in scripts/25-kmi-bisect.sh, and every stock module failed the check.

# Early boot, independent of which ramdisk LK loads. See HANDOFF.md "Boot design".
CONFIG_INITRAMFS_SOURCE="/build/kernel/initramfs.list"
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure rdinit=/archinit"
# LOCALVERSION_AUTO must stay on: it enables MODULE_SCMVERSION, which is a field in
# struct module. Without it, stock modules fail with a bad this_module size.
CONFIG_LOCALVERSION="-archpad"

# Virtual HCI adapter, built as a module (scripts/27-build-hci-vhci.sh) for the Bluetooth bridge.
CONFIG_BT_HCIVHCI=m
