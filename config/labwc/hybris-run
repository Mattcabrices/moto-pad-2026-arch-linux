#!/bin/bash
# Moto Pad (archpad): run a Wayland app with GPU rendering (Mali via libhybris) inside the GPU desktop.
# Usage: hybris-run <command> [args...]   e.g. hybris-run mpv video.mkv
# Works for apps that use EGL/GLES on Wayland: es2gears/glmark2, GTK4, mpv (--vo=gpu). Apps that only draw with
# the CPU are unaffected. Browsers have their own launchers that use this: firefox-gpu (needs a TLS-relocated
# Firefox binary) and chromium-gpu (needs extra Chromium flags).
# Outside the GPU desktop (Xorg session, or Android services not running) the app just runs normally.
[ $# -gt 0 ] || { echo "usage: hybris-run <command> [args...]" >&2; exit 2; }
if [ -z "$WAYLAND_DISPLAY" ] || ! pgrep -f 'graphics.allocator@4.0-service' >/dev/null; then
  exec "$@"
fi
export LD_LIBRARY_PATH=/usr/local/hybris/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
# Android code writes bionic TLS slots that overlap glibc TLS; this pads them (tools/src/bionic-tls-pad.c).
case ":$LD_PRELOAD:" in *bionic-tls-pad*) ;; *) export LD_PRELOAD=/usr/local/hybris/lib/bionic-tls-pad.so${LD_PRELOAD:+:$LD_PRELOAD} ;; esac
export HYBRIS_LD_LIBRARY_PATH=/vendor/lib64:/system/lib64:/odm/lib64:/usr/local/hybris/compat
export EGL_PLATFORM=wayland
exec "$@"
