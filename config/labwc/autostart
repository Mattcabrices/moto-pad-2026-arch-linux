# Moto Pad (archpad) labwc autostart (/etc/xdg/labwc/autostart): the XFCE pieces that work on Wayland.
xfce4-panel &
xfdesktop &
# On-screen keyboard (Onboard is X11-only). Pops up on text fields via text-input-v3/input-method-v2.
squeekboard &
# Screen off after 5 minutes without input, unless a video is playing (config/screen; /etc/archpad/screen.conf).
archpad-screen idle &
