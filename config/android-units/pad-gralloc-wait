#!/bin/bash
# Waits until the allocator HAL is registered (IAllocator in lshal); used by pad-gralloc.service.
for i in $(seq 30); do
  chroot /opt/android-full /system/bin/env LD_PRELOAD=/data/local/libpropshim.so /system/bin/lshal -i 2>/dev/null | grep -q 'IAllocator/default' && exit 0
  sleep 1
done
echo "allocator did not register within 30 s" >&2; exit 1
