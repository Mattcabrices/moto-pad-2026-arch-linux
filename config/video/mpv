#!/bin/bash
# Moto Pad (archpad): mpv with hardware video decoding (MediaTek decoder via libmtk-v4l2-shim) and, inside the GPU
# desktop, GPU rendering (hybris-run). Installed as /usr/local/bin/mpv, ahead of /usr/bin/mpv in PATH.
# H.264, HEVC, VP9, MPEG-4 and H.263 up to 2560x1440 (8-bit) decode in hardware; anything else (AV1, 10-bit, larger)
# falls back to software automatically. Plain software decoding: mpv --hwdec=no ...
SHIM=/usr/local/lib/libmtk-v4l2-shim.so
HW=()
if [ -e "$SHIM" ] && [ -w /dev/dma_heap/system ]; then
  export LD_PRELOAD=$SHIM${LD_PRELOAD:+:$LD_PRELOAD}
  HW=(--hwdec=v4l2m2m-copy)
fi
# profile=fast: bilinear scaling. mpv's default scalers cost ~65 ms per frame at full screen on this GPU (1080p played
# at ~15 fps); with fast, 1080p60 plays at the full 60 fps with no dropped frames.
# display-resample: smoother pacing; with mpv's default sync, frames were dropped needlessly.
exec /usr/local/bin/hybris-run /usr/bin/mpv "${HW[@]}" --profile=fast --video-sync=display-resample "$@"
